{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "environment": "production",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "staging": {
      "extends": "production",
      "autoIncrement": false,
      "channel": "staging",
      "environment": "production"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "local-production": {
      "extends": "production",
      "autoIncrement": false
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6771245057"
      }
    }
  }
}
